rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /communities/bistekville {
      allow read, write: if request.auth != null;
    }
    match /communities/bistekville/paymentProofs/{proofId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.imageData is string
        && request.resource.data.imageData.size() < 800000
        && request.resource.data.contentType == 'image/jpeg';
    }
  }
}
